# Copy to .env and uncomment what you want to change.

# Where the documents live (defaults to ../ai_ml_knowledge_base)
# RAG_KB_DIR=D:/RAG/ai_ml_knowledge_base

# Where generated data is written (defaults to ./data)
# RAG_DATA_DIR=D:/RAG/rag_project/data

# Chunking (tokens). Keep chunk_size well under the embedding model's limit.
# RAG_CHUNK_SIZE=400
# RAG_CHUNK_OVERLAP=80

# Embeddings
# RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RAG_EMBEDDING_BATCH_SIZE=32

# Retrieval
# RAG_TOP_K=8
# RAG_CANDIDATE_K=40
# RAG_MMR_LAMBDA=0.7
